    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tSqrt", ",", "sqrtVal"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "X", "]"}], ".", "X"}], ",", 
            RowBox[{"1", "/", "2"}]}], "]"}], "-", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "Y", "]"}], ".", "Y"}], ",", 
            RowBox[{"1", "/", "2"}]}], "]"}]}], ",", "\"\<Frobenius\>\""}], 
        "]"}], "^", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Matrix-sqrt bound: \>\"", ",", 
