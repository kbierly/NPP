Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Random", " ", "rank"}], "-", 
     RowBox[{
     "2", " ", "Y", " ", "and", " ", "compatible", " ", "X", " ", "such", " ",
       "that", " ", "AX"}]}], "=", 
    RowBox[{"Y", " ", "has", " ", "a", " ", "solution"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"3", "\[Times]", "2", " ", "matrix"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Choose", " ", "X"}], "=", 
      RowBox[{
       RowBox[{"Aproj", "^", 
        RowBox[{"-", "1"}]}], "*", "Y", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"or", " ", "just", " ", "let", " ", "Aproj", "*", "X"}], "=",
          "Y"}], ")"}]}]}], "*)"}], 
    RowBox[{"Aproj", "=", 
     RowBox[{"Y", ".", 
      RowBox[{"PseudoInverse", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "Y", "]"}], ".", "Y"}], "]"}], ".", 
      RowBox[{"Transpose", "[", "Y", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"X", "=", 
     RowBox[{"Aproj", ".", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"ensure", " ", "AX"}], "=", "Y"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{"Construct", " ", "S"}], "*)"}], 
    RowBox[{"S", "=", 
     RowBox[{
      RowBox[{"Y", ".", 
       RowBox[{"Transpose", "[", "X", "]"}]}], "+", 
      RowBox[{"X", ".", 
       RowBox[{"Transpose", "[", "Y", "]"}]}], "-", 
      RowBox[{"X", ".", 
       RowBox[{"Transpose", "[", "X", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Positive", "-", 
      RowBox[{"eigenprojection", " ", "solution"}]}], "*)"}], 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "S", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Astar", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", "0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Test \>\"", ",", "i", ",", "\"\<: Astar == Aproj ? \>\"", ",", 
      RowBox[{"Astar", "==", "Aproj"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Norm[Astar.X - Y] = \>\"", ",", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Astar", ".", "X"}], "-", "Y"}], ",", "\"\<Frobenius\>\""}], 
       "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Norm[Aproj.X - Y] = \>\"", ",", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
