Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Set", " ", "dimensions"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"m", "=", "1000"}], ";", 
    RowBox[{"n", "=", "900"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"1", ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"1", ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n===== Procrustes Approximation Bounds =====\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Exact", " ", "Procrustes", " ", "via", " ", "SVD"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tSVD", ",", "svdVal"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"U", ",", "S", ",", "V"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
          RowBox[{"SingularValueDecomposition", "[", 
           RowBox[{"X", ".", 
            RowBox[{"Transpose", "[", "Y", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"X", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"Y", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"Diagonal", "[", "S", "]"}], "]"}]}]}]}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exact Procrustes (SVD): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"svdVal", ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "5"}], "}"}]}], "]"}], ",", 
      "\"\< (computed in \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"tSVD", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "4"}], "}"}]}], "]"}], ",", "\"\< s)\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exact Procrustes SQRT: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "svdVal", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "5"}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Frobenius", "-", "bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Extra", " ", "line", " ", "break", " ", "for", " ", "separation"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tFrob", ",", "frobVal"}], "}"}], "=", 
