   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Difference (Frobenius-bound - exact): \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"diffFrob", ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "5"}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Matrix", " ", "square"}], "-", 
     RowBox[{"root", " ", "bound"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], " ", 
