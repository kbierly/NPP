    "Extra", " ", "line", " ", "break", " ", "for", " ", "separation"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tTest", ",", "testVal"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], "*", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "X", "]"}], ".", "X"}], "-", 
          RowBox[{
           RowBox[{"Transpose", "[", "Y", "]"}], ".", "Y"}]}], ",", 
         "\"\<Frobenius\>\""}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Matrix-test bound (SQRT value): \>\"", ",", 
