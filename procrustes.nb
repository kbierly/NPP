Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Base", " ", "matrices"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1.1", ",", "0.1", ",", "0.2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.05", ",", "0.95", ",", 
         RowBox[{"-", "0.1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.9", ",", "1.05", ",", "0.95"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Construct", " ", "Hermitian", " ", "S"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{
      RowBox[{"Y", ".", 
       RowBox[{"Transpose", "[", "X", "]"}]}], "+", 
      RowBox[{"X", ".", 
       RowBox[{"Transpose", "[", "Y", "]"}]}], "-", 
      RowBox[{"X", ".", 
       RowBox[{"Transpose", "[", "X", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Standard", " ", "orthogonal", " ", "projection", " ", "solution"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Aproj", "=", 
     RowBox[{"Y", ".", 
      RowBox[{"PseudoInverse", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "Y", "]"}], ".", "Y"}], "]"}], ".", 
      RowBox[{"Transpose", "[", "Y", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Positive", "-", 
     RowBox[{"eigenprojection", " ", "solution"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "S", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Astar", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", "0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compare", " ", "norms"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Aproj", ".", "X"}], "-", "Y"}], ",", "\"\<Frobenius\>\""}], 
    "]"}], "\n", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Astar", ".", "X"}], "-", "Y"}], ",", "\"\<Frobenius\>\""}], 
    "]"}], "\n", 
   RowBox[{"Astar", "==", "Aproj"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9751858705368013`*^9, 3.9751858705378637`*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"6c408fa5-1340-4f6f-b0ad-9642d0db752d"],

