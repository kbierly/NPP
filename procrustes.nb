      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"X", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"Y", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"X", ".", 
           RowBox[{"Transpose", "[", "Y", "]"}]}], ",", "\"\<Frobenius\>\""}],
          "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Frobenius-bound: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"frobVal", ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "5"}], "}"}]}], "]"}], ",", 
      "\"\< (computed in \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"tFrob", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "4"}], "}"}]}], "]"}], ",", "\"\< s)\>\""}], "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Difference", " ", "Frobenius"}], "-", 
     RowBox[{"bound", " ", "minus", " ", "exact"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diffFrob", "=", 
